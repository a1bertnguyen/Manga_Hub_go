    {
      "name": "7. Fault Injection (Manual gRPC Down -> 503)",
      "item": [
        {
          "name": "Verify Bounded Failure (503 when Catalog Stopped)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responds within bounded timeout (< 2500ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2500);",
                  "});",
                  "",
                  "pm.test(\"Returns 200 (Catalog UP) or 503 (Catalog DOWN)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "",
                  "if (pm.response.code === 503) {",
                  "    console.log(\"Fault Injection Verified: Backend returned HTTP 503 when gRPC Catalog (:9092) was stopped!\");",
                  "} else {",
                  "    console.log(\"Catalog service is currently RUNNING (200 OK). To test 503 fallback, stop cmd/catalog and click Send again.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manga?q=One",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manga"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "One"
                }
              ]
            },
            "description": "Manual Fault Injection Demo:\n1. Stop the gRPC Catalog process (:9092).\n2. Send this request.\n3. Verify that Backend does NOT hang and instead fails bounded within 2s returning HTTP 503 Service Unavailable."
          },
          "response": []
        }
      ]
    }
