  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Health Check (All 5 Protocols)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Backend reports healthy with all 5 protocol services\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"healthy\");",
                  "    pm.expect(jsonData.services).to.have.property(\"http\");",
                  "    pm.expect(jsonData.services).to.have.property(\"tcp\");",
                  "    pm.expect(jsonData.services).to.have.property(\"udp\");",
                  "    pm.expect(jsonData.services).to.have.property(\"websocket\");",
                  "    pm.expect(jsonData.services).to.have.property(\"grpc_catalog\");",
                  "});",
                  "",
                  "pm.test(\"gRPC Catalog service is connected\", function () {",
                  "    pm.expect(jsonData.services.grpc_catalog).to.eql(\"connected\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Verifies HTTP REST (:8080), TCP Sync (:9090), UDP (:9091), WebSocket (/ws), and gRPC Catalog (:9092) connectivity."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register New User (200 OK - Auto Save Token)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = Date.now() + \"_\" + Math.floor(Math.random() * 1000);",
                  "pm.collectionVariables.set(\"testUsername\", \"postman_\" + uniqueId);",
                  "pm.collectionVariables.set(\"testEmail\", \"postman_\" + uniqueId + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Returns JWT token, user_id, and username\", function () {",
                  "    pm.expect(jsonData.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.user_id).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(jsonData.username).to.eql(pm.collectionVariables.get(\"testUsername\"));",
                  "});",
                  "",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    pm.collectionVariables.set(\"userId\", jsonData.user_id);",
                  "    pm.collectionVariables.set(\"username\", jsonData.username);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Generates a fresh user on each run and automatically stores {{token}}, {{userId}}, and {{username}} into Collection Variables."
