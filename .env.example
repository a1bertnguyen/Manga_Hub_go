# MangaHub Environment Configuration
# Copy this file to .env or export variables directly

# Server Ports
HTTP_PORT=8080
TCP_PORT=9090
UDP_PORT=9091
GRPC_PORT=9092

# Service Addresses
CATALOG_GRPC_ADDR=localhost:9092

# SQLite Database Paths
BACKEND_DB_PATH=./mangahub-main/MangaHub-main/data/mangahub.db
CATALOG_DB_PATH=./mangahub-main/MangaHub-main/data/catalog.db

# Authentication
JWT_SECRET=mangahub_secret_jwt_key_2026
